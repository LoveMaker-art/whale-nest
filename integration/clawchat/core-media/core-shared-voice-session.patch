+  it("keeps voice and text on the same queued runtime handle without projecting voice", async () => {
+    const fixture = await runtimeFixture();
+    const entered = Promise.withResolvers<void>();
+    const release = Promise.withResolvers<void>();
+    const visibleText = mock(async function* () {yield activity("ordinary text result");});
+    const native = {prompt: visibleText, cancel: mock(async () => true), close: mock(async () => {})};
+    const start = mock(async () => native);
+    const runtimeAdapters = new RuntimeAdapterRegistry([fixedRuntimeAdapter({kind: "codex", modes: [], start})]);
+    const projection = new TranscriptProjection({config: fixture.config, stateStore: fixture.store, runtimeAdapters});
+    const runtime = new ConnectRuntime({
+      agentId: "codex", config: fixture.config, configPath: fixture.configPath,
+      stateStore: fixture.store, wsClient: fixture.wsClient, runtimeAdapters, transcriptProjection: projection,
+    });
+    const request = {chatId: "chat-1", ownerId: "user-1"};
+    const voice = runtime.withPrivateVoiceSession(request, new AbortController().signal, async (session) => {
+      expect(session).toBe(native);
+      entered.resolve();
+      await release.promise;
+    });
+    try {
+      await Promise.race([entered.promise, voice.then(() => {throw new Error("Voice did not acquire its session");})]);
+      const text = runtime.handleInboundMessage(message("ordinary text input"));
+      const cancelled = new AbortController();
+      const discarded = mock(async () => {});
+      const queued = runtime.withPrivateVoiceSession(request, cancelled.signal, discarded);
+      const result = queued.then(() => null, error => error);
+      await Bun.sleep(20);
+      expect(visibleText).not.toHaveBeenCalled();
+      cancelled.abort();
+      expect(await result).toBeInstanceOf(Error);
+      expect(discarded).not.toHaveBeenCalled();
+      release.resolve();
+      await voice;
+      await text;
+      expect(start).toHaveBeenCalledTimes(1);
+      expect(visibleText).toHaveBeenCalledTimes(1);
+      const current = await fixture.store.getCurrentRuntimeSession("chat-1", "codex");
+      const blocks = await fixture.store.listTranscriptBlocks(current!.sessionRef);
+      expect(blocks.filter(block => block.type === "message")).toHaveLength(2);
+      expect(JSON.stringify(blocks)).toContain("ordinary text input");
+      expect(JSON.stringify(blocks)).toContain("ordinary text result");
+      expect(fixture.sendMessageEnvelope).toHaveBeenCalledTimes(1);
+    } finally {
+      release.resolve();
+      await voice.catch(() => undefined);
+      await runtime.dispose();
+      await runtimeAdapters.close();
+      await fixture.store.close();
+    }
+  });
