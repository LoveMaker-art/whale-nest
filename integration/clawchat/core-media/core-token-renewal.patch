diff --git a/src/clawchat/token-renewal.ts b/src/clawchat/token-renewal.ts
new file mode 100644
index 0000000..8118a8c
--- /dev/null
+++ b/src/clawchat/token-renewal.ts
@@ -0,0 +1,230 @@
+import type { ConnectStateStore } from "../persistence/state";
+import type { ActivationCredentials } from "../types";
+import { AuthError } from "./protocol";
+
+const minute = 60_000;
+const retryDelayMs = 30_000;
+const maximumTimeoutMs = 2 ** 31 - 1;
+
+interface Claims {
+  exp?: number;
+  iat?: number;
+  sub?: string;
+  aid?: string;
+  oid?: string;
+  did?: string;
+}
+
+function claims(token: string): Claims {
+  const payload = token.split(".")[1];
+  if (!payload || payload.length > 16_384) return {};
+  try {
+    return JSON.parse(Buffer.from(payload, "base64url").toString()) ?? {};
+  } catch {
+    return {};
+  }
+}
+
+function expiresAt(tokenClaims: Claims): number | null {
+  const expiry = tokenClaims.exp;
+  return typeof expiry === "number" && Number.isSafeInteger(expiry) && expiry > 0 ? expiry * 1000 : null;
+}
+
+export function accessTokenExpired(token: string): boolean {
+  const expiry = expiresAt(claims(token));
+  return expiry !== null && expiry <= Date.now();
+}
+
+function renewalTime(token: string): number {
+  const c = claims(token);
+  const expiry = expiresAt(c);
+  if (expiry === null) return Infinity;
+  const issued = c.iat;
+  const lifetime =
+    typeof issued === "number" && Number.isSafeInteger(issued) && issued * 1000 < expiry
+      ? expiry - issued * 1000
+      : 24 * 60 * minute;
+  const lead = Math.max(30 * minute, Math.min(120 * minute, lifetime / 4));
+  return expiry - lead + (Math.random() * 10 - 5) * minute;
+}
+
+function sameBinding(left: ActivationCredentials, right: ActivationCredentials): boolean {
+  return (
+    left.localAgentId === right.localAgentId &&
+    left.userId === right.userId &&
+    left.ownerUserId === right.ownerUserId &&
+    left.serverAgentId === right.serverAgentId &&
+    left.conversationId === right.conversationId
+  );
+}
+
+type Pair = { accessToken: string; refreshToken: string };
+
+/** One renewal owner per active Binding, sharing the existing SQLite activation with the rest of Connect. */
+export class ClawChatTokenRenewal {
+  private nextAttempt = 0;
+  private renewAt: number;
+  private timer: ReturnType<typeof setTimeout> | undefined;
+  private inFlight: Promise<void> | undefined;
+  private pending: Pair | undefined;
+  private blocked: string | undefined;
+  private stopped = false;
+  private discardRotation = false;
+
+  constructor(
+    private current: ActivationCredentials,
+    private readonly options: {
+      baseUrl: string;
+      deviceId: string;
+      state: Pick<ConnectStateStore, "getActivation" | "rotateActivationCredentials">;
+      onError: (error: AuthError) => void;
+      onBlocked: (error: AuthError) => void;
+      onRenewed?: () => void;
+    },
+  ) {
+    this.renewAt = renewalTime(current.accessToken);
+  }
+
+  get credentials(): ActivationCredentials {
+    return this.current;
+  }
+
+  async beforeConnect(): Promise<boolean> {
+    if (this.stopped || this.blocked) throw new AuthError(this.blocked ?? "ClawChat binding is closed");
+    if (this.pending || Date.now() >= this.renewAt) await this.renew();
+    if (this.stopped || this.blocked) throw new AuthError(this.blocked ?? "ClawChat binding is closed");
+    if (!accessTokenExpired(this.current.accessToken)) return true;
+    if (!this.current.refreshToken)
+      throw new AuthError("ClawChat access expired and no renewal credential is available");
+    return false;
+  }
+
+  start(): void {
+    this.schedule();
+  }
+
+  async stop(discardRotation = false): Promise<void> {
+    this.stopped = true;
+    this.discardRotation ||= discardRotation;
+    clearTimeout(this.timer);
+    await this.inFlight;
+  }
+
+  private schedule(): void {
+    clearTimeout(this.timer);
+    if (this.stopped || this.blocked || !this.current.refreshToken || !Number.isFinite(this.renewAt)) return;
+    const delay = Math.min(maximumTimeoutMs, Math.max(0, Math.max(this.renewAt, this.nextAttempt) - Date.now()));
+    this.timer = setTimeout(() => {
+      if (Date.now() < Math.max(this.renewAt, this.nextAttempt)) this.schedule();
+      else void this.renew();
+    }, delay);
+    this.timer.unref?.();
+  }
+
+  private renew(): Promise<void> {
+    if (this.inFlight) return this.inFlight;
+    if (this.stopped || this.blocked || !this.current.refreshToken || Date.now() < this.nextAttempt) {
+      return Promise.resolve();
+    }
+    this.nextAttempt = Date.now() + retryDelayMs;
+    this.inFlight = this.perform()
+      .catch(() => {
+        this.options.onError(new AuthError("ClawChat credential renewal failed temporarily"));
+      })
+      .finally(() => {
+        this.inFlight = undefined;
+        this.schedule();
+      });
+    return this.inFlight;
+  }
+
+  private adopt(current: ActivationCredentials): void {
+    this.current = current;
+    this.pending = undefined;
+    this.renewAt = renewalTime(current.accessToken);
+  }
+
+  private block(reason: string): void {
+    this.blocked = reason;
+    this.options.onBlocked(new AuthError(reason));
+  }
+
+  // A concurrent re-pair or removal must not be overwritten, even if it happens while HTTP is in flight.
+  private async checkStored(): Promise<boolean> {
+    const stored = await this.options.state.getActivation(this.current.localAgentId);
+    const originalDevice = claims(this.current.accessToken).did;
+    if (
+      !stored ||
+      !sameBinding(this.current, stored) ||
+      (originalDevice && claims(stored.accessToken).did !== originalDevice)
+    ) {
+      this.block("ClawChat binding changed during renewal");
+      return false;
+    }
+    if (stored.accessToken !== this.current.accessToken || stored.refreshToken !== this.current.refreshToken) {
+      this.adopt(stored);
+      return false;
+    }
+    return true;
+  }
+
+  private async perform(): Promise<void> {
+    if (!(await this.checkStored()) || this.discardRotation) return;
+    if (!this.pending) {
+      const previous = claims(this.current.accessToken);
+      const deviceId = typeof previous.did === "string" && previous.did ? previous.did : this.options.deviceId;
+      const response = await fetch(new URL("/v1/auth/refresh", this.options.baseUrl), {
+        method: "POST",
+        headers: { "content-type": "application/json", "x-device-id": deviceId },
+        body: JSON.stringify({ refresh_token: this.current.refreshToken }),
+        redirect: "error",
+        signal: AbortSignal.timeout(10_000),
+      });
+      const envelope = (await response.json()) as {
+        code?: number | string;
+        data?: { access_token?: string; refresh_token?: string };
+      };
+      if (this.discardRotation) return;
+      const code = Number(envelope.code);
+      if (code === 10003) {
+        if (await this.checkStored()) this.block("ClawChat renewal credential was rejected");
+        return;
+      }
+      const accessToken = envelope.data?.access_token;
+      const refreshToken = envelope.data?.refresh_token;
+      if (
+        !response.ok ||
+        code !== 0 ||
+        typeof accessToken !== "string" ||
+        typeof refreshToken !== "string" ||
+        !refreshToken ||
+        refreshToken === this.current.refreshToken
+      ) {
+        throw new Error("Renewal did not return a new credential pair");
+      }
+      const next = claims(accessToken);
+      const expiry = expiresAt(next);
+      if (
+        expiry === null ||
+        expiry <= Date.now() ||
+        next.sub !== this.current.userId ||
+        next.oid !== this.current.ownerUserId ||
+        (this.current.serverAgentId !== null && next.aid !== this.current.serverAgentId) ||
+        next.did !== deviceId
+      ) {
+        this.block("ClawChat renewal returned a credential for a different binding");
+        return;
+      }
+      this.pending = { accessToken, refreshToken };
+    }
+    // If SQLite is temporarily unavailable, retry this write with the received pair.
+    // The old refresh credential may already be spent at the server.
+    const pair = this.pending;
+    if (await this.options.state.rotateActivationCredentials(this.current, pair.accessToken, pair.refreshToken)) {
+      this.adopt({ ...this.current, ...pair });
+      this.options.onRenewed?.();
+    } else if (await this.checkStored()) {
+      throw new Error("Credential rotation could not be persisted");
+    }
+  }
+}
