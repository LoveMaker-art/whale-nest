+import { expect, test } from "bun:test";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { CONNECT_PLUGIN_LOCK_FORMAT, isPluginActivationCurrent, pluginInstallationPaths } from "../src/plugin/store";
+
+test("voice admission checks the current activation without loading unrelated version manifests", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "connect-voice-activation-"));
+  const configPath = join(directory, "config.json");
+  const { lockfile } = pluginInstallationPaths(configPath);
+  const pluginId = "whalenest.runtime.deepseek-harness";
+  const entry = { pluginId, activationGeneration: 7, status: "active", retainedVersions: ["unused version metadata"] };
+  const write = (plugins: Record<string, unknown>) =>
+    writeFile(lockfile, JSON.stringify({ format: CONNECT_PLUGIN_LOCK_FORMAT, plugins }));
+  try {
+    expect(await isPluginActivationCurrent(configPath, pluginId, 7)).toBe(false);
+    await mkdir(dirname(lockfile), { recursive: true });
+    await write({ [pluginId]: entry, "other.runtime": "unused plugin metadata" });
+    expect(await isPluginActivationCurrent(configPath, pluginId, 7)).toBe(true);
+    expect(await isPluginActivationCurrent(configPath, pluginId, 6)).toBe(false);
+    await write({ [pluginId]: { ...entry, activationGeneration: 8 } });
+    expect(await isPluginActivationCurrent(configPath, pluginId, 7)).toBe(false);
+    await write({ [pluginId]: { ...entry, status: "disabled" } });
+    expect(await isPluginActivationCurrent(configPath, pluginId, 7)).toBe(false);
+    await write({ [pluginId]: { ...entry, pluginId: "other.runtime" } });
+    expect(await isPluginActivationCurrent(configPath, pluginId, 7)).toBe(false);
+    await write({});
+    expect(await isPluginActivationCurrent(configPath, pluginId, 7)).toBe(false);
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+});
