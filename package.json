{
  "name": "whale-nest",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "description": "基于 DSH 的云端陪伴插件，支持 ClawChat 和 QQ",
  "scripts": {
    "check": "node scripts/check.mjs",
    "start": "node scripts/start.mjs",
    "test": "node scripts/test.mjs",
    "test:upstream": "node scripts/test.mjs --upstream",
    "check:vendor": "node scripts/check-vendor.mjs",
    "build:connect": "node scripts/build-connect.mjs",
    "health": "node scripts/health.mjs",
    "prepare:connect": "node scripts/prepare-connect.mjs",
    "test:deployment": "node scripts/test.mjs test/live-update.test.mjs",
    "build:distribution": "node scripts/build-distribution.mjs",
    "preflight:m2": "node scripts/update-m2.mjs preflight",
    "deploy:m2": "node scripts/update-m2.mjs install"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-base": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-app": "0.2.2-rc.1",
    "js-yaml": "4.3.2"
  },
  "overrides": {
    "undici@8.11.2": "8.12.2",
    "zod@4.4.3": "4.6.7",
    "@deepseek-ai/libreoffice-kit": {
      "fflate": "0.8.3"
    },
    "@deepseek-ai/dsh-mcp-client": {
      "@modelcontextprotocol/client": "2.3.0"
    }
  }
}
