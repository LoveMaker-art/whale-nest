+test("simultaneous refresh requests share one POST, and storage failure retries persisting the already issued pair", async () => {
+  const actualNow = Date.now();
+  const now = Math.floor(actualNow / 1000);
+  const clock = spyOn(Date, "now").mockReturnValue(actualNow);
+  const f = await fixture({ iat: now - validFor, exp: now - 1 });
+  const save = mock(f.state.rotateActivationCredentials.bind(f.state));
+  save.mockImplementationOnce(async () => {
+    throw new Error("fixture disk failure");
+  });
+  const renew = new ClawChatTokenRenewal(f.original, {
+    baseUrl: f.config.baseUrl,
+    deviceId: websocketDevice,
+    state: { getActivation: f.state.getActivation.bind(f.state), rotateActivationCredentials: save },
+    onError: () => undefined,
+    onBlocked: () => undefined,
+  });
+  try {
+    expect(await Promise.all([renew.beforeConnect(), renew.beforeConnect()])).toEqual([false, false]);
+    expect(f.requests).toHaveLength(1);
+    expect(await f.state.getActivation(agentId)).toEqual(f.original);
+    expect(await renew.beforeConnect()).toBe(false);
+    clock.mockReturnValue(actualNow + 31_000);
+    expect(await renew.beforeConnect()).toBe(true);
+    expect(await f.state.getActivation(agentId)).toEqual(f.rotated);
+    expect(f.requests).toHaveLength(1);
+    expect(save).toHaveBeenCalledTimes(2);
+  } finally {
+    await renew.stop();
+    await f.close();
+    clock.mockRestore();
+  }
+});
