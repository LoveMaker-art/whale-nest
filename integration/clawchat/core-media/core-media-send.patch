+
+async function sendMedia(input: Record<string, unknown>, ws: ConnectWsClient): Promise<unknown> {
+  const filePath = String(input.filePath);
+  if (!isAbsolute(filePath)) throw new Error("filePath must be absolute");
+  const handle = await open(filePath, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  let file: Blob;
+  try {
+    const metadata = await handle.stat();
+    if (!metadata.isFile() || metadata.size <= 0 || metadata.size > 100 * 1024 * 1024)
+      throw new Error("media must be a non-empty regular file of at most 100 MiB");
+    const bytes = await handle.readFile();
+    if (bytes.length !== metadata.size) throw new Error("media changed while reading");
+    if (
+      input.sha256 != null &&
+      (!/^[a-f0-9]{64}$/.test(String(input.sha256)) ||
+        createHash("sha256").update(bytes).digest("hex") !== input.sha256)
+    )
+      throw new Error("media SHA-256 mismatch");
+    const mime = extname(filePath).toLowerCase() === ".wav" ? "audio/wav" : Bun.file(filePath).type;
+    file = new Blob([bytes], { type: mime || "application/octet-stream" });
+  } finally {
+    await handle.close();
+  }
+  const fragment = await ws.uploadMedia(file, { filename: basename(filePath) });
+  if (input.expectedKind != null && fragment.kind !== input.expectedKind)
+    throw new Error("uploaded media kind mismatch");
+  const media = { ...fragment };
+  if (input.duration != null) {
+    if (media.kind !== "audio" && media.kind !== "video") throw new Error("duration requires uploaded audio or video");
+    Object.assign(media, { duration: input.duration });
+  }
+  for (const key of ["width", "height"]) {
+    if (input[key] == null) continue;
+    if (media.kind !== "image" && media.kind !== "video") throw new Error(`${key} requires uploaded image or video`);
+    Object.assign(media, { [key]: input[key] });
+  }
+  const payload = buildTextMessagePayload(typeof input.caption === "string" ? input.caption : "", {
+    replyToMessageId: typeof input.replyToMessageId === "string" ? input.replyToMessageId : undefined,
+  });
+  payload.message.body.fragments.push(media);
+  try {
+    const ack = await ws.sendMessageEnvelope(EVENT.MESSAGE_REPLY, String(input.chatId), payload, {
+      toType: input.chatType as ChatType,
+    });
+    if (!ack.payload.message_id) throw new Error("message acknowledgement did not contain a message ID");
+    const record = fragment as Record<string, unknown>;
+    return {
+      sent: true,
+      messageId: ack.payload.message_id,
+      kind: fragment.kind,
+      name: record.name,
+      mime: record.mime,
+      size: record.size,
+    };
+  } catch (error) {
+    if (error instanceof MessageSendError) throw error;
+    if (isIndeterminateToolError(error)) throw error;
+    throw new IndeterminateToolExecutionError(
+      `media send outcome is unknown: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
 }
 
