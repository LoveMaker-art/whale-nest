+++ b/src/service/agent-liveware-relay.ts
@@ -0,0 +1,46 @@
+import type { LivewareAgentProcess } from "./liveware-control";
+
+export function createAgentLivewareRelay({
+  open,
+  onError,
+}: {
+  open(): Promise<LivewareAgentProcess>;
+  onError(): void;
+}) {
+  let active: LivewareAgentProcess | undefined;
+  let starting: Promise<void> | undefined;
+  let closing: Promise<void> | undefined;
+  let closed = false;
+
+  function start(): Promise<void> {
+    if (closed) return Promise.resolve();
+    if (starting) return starting;
+    if (active) return Promise.resolve();
+    starting = (async () => {
+      const relay = await open();
+      if (closed) {
+        await relay.stop();
+        return;
+      }
+      active = relay;
+      const release = () => { if (active === relay) active = undefined; };
+      void relay.exited.then(release, release);
+      try {
+        await relay.ready;
+      } catch (error) {
+        await relay.stop().catch(() => undefined);
+        release();
+        throw error;
+      }
+    })().catch(() => { if (!closed) onError(); }).finally(() => { starting = undefined; });
+    return starting;
+  }
+
+  function close(): Promise<void> {
+    closed = true;
+    closing ??= Promise.allSettled([active?.stop(), starting]).then(() => undefined);
+    return closing;
+  }
+
+  return { start, close };
+}
