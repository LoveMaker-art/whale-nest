+import { expect, mock, spyOn, test } from "bun:test";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { ClawChatTokenRenewal } from "../src/clawchat/token-renewal";
+import { defaultConfig } from "../src/config";
+import { createStateStore } from "../src/persistence/state";
+import { RuntimeAdapterRegistry } from "../src/runtime/registry";
+import { type BindingRuntimeHandle, startBindingRuntime } from "../src/service/binding-runtime";
+import { WorkspaceCatalog } from "../src/workspaces/workspaces";
+import { fixedRuntimeAdapter, pluginBinding } from "./runtime-adapter-fixture";
+
+const agentId = "codex";
+const binding = {
+  localAgentId: agentId,
+  userId: "fixture-user",
+  serverAgentId: "fixture-agent",
+  ownerUserId: "fixture-owner",
+  conversationId: "fixture-private",
+};
+const pairedDevice = "paired-rest-device";
+const websocketDevice = "websocket-device";
+const validFor = 7 * 24 * 3600;
+function jwt(iat: number, exp: number, oid = binding.ownerUserId): string {
+  return [
+    "eyJhbGciOiJIUzI1NiJ9",
+    Buffer.from(
+      JSON.stringify({ iat, exp, sub: binding.userId, aid: binding.serverAgentId, oid, did: pairedDevice }),
+    ).toString("base64url"),
+    "fixtureSignature",
+  ].join(".");
+}
+
+async function fixture(credential: { iat: number; exp: number }, options: { refresh?: () => Promise<Response> } = {}) {
+  const workspace = await mkdtemp(join(tmpdir(), "connect-renewal-"));
+  const state = createStateStore({ dbPath: join(workspace, "state.sqlite") });
+  const runtimeAdapters = new RuntimeAdapterRegistry([
+    fixedRuntimeAdapter({
+      kind: agentId,
+      modes: ["read-only"],
+      start: async () => {
+        throw new Error("No conversation requested");
+      },
+    }),
+  ]);
+  const now = Math.floor(Date.now() / 1000);
+  const original = { ...binding, accessToken: jwt(credential.iat, credential.exp), refreshToken: "old-fixture" };
+  const rotated = { ...binding, accessToken: jwt(now, now + validFor), refreshToken: "new-fixture" };
+  await state.upsertActivation(original);
+  const handshakes: string[] = [];
+  const persistedBeforeHandshake: boolean[] = [];
+  const requests: { device: string | null; authorization: string | null; body: unknown }[] = [];
+  let socket: { close(code?: number, reason?: string): void } | undefined;
+  const errors: string[] = [];
+  const mediaAuthorization: (string | null)[] = [];
+  let handle: BindingRuntimeHandle | undefined;
+  const server = Bun.serve({
+    hostname: "127.0.0.1",
+    port: 0,
+    async fetch(req, server) {
+      const path = new URL(req.url).pathname;
+      if (path === "/ws" && server.upgrade(req)) return;
+      if (path === "/v1/auth/refresh") {
+        requests.push({
+          device: req.headers.get("x-device-id"),
+          authorization: req.headers.get("authorization"),
+          body: await req.json(),
+        });
+        if (options.refresh) return await options.refresh();
+        return Response.json({
+          code: 0,
+          data: { access_token: rotated.accessToken, refresh_token: rotated.refreshToken },
+        });
+      }
+      if (path === "/media/upload") {
+        mediaAuthorization.push(req.headers.get("authorization"));
+        return Response.json({
+          code: 0,
+          data: { kind: "file", url: "https://example.test/attachment", name: "note.txt" },
+        });
+      }
+      return Response.json({ code: 0, data: {} });
+    },
+    websocket: {
+      open(ws) {
+        socket = ws;
+        ws.send(
+          JSON.stringify({
+            version: "2",
+            event: "connect.challenge",
+            trace_id: "challenge",
+            emitted_at: 1,
+            payload: { nonce: "Wn9hZ3lJZkN1QXBkUEpYbmNk" },
+          }),
+        );
+      },
+      async message(ws, raw) {
+        const frame = JSON.parse(String(raw));
+        if (frame.event !== "connect") return;
+        handshakes.push(frame.payload.token);
+        persistedBeforeHandshake.push((await state.getActivation(agentId))?.accessToken === frame.payload.token);
+        const rejected = credential.exp <= now && frame.payload.token === original.accessToken;
+        ws.send(
+          JSON.stringify({
+            version: "2",
+            trace_id: frame.trace_id,
+            emitted_at: 2,
+            event: rejected ? "hello-fail" : "hello-ok",
+            payload: rejected
+              ? { reason: "authentication failed" }
+              : {
+                  device_id: websocketDevice,
+                  ack_mode: "dseq",
+                  ack_epoch: "01JXYZ8K3MNPQRSTVWXYZ0AD",
+                },
+          }),
+        );
+      },
+    },
+  });
+  const config = defaultConfig();
+  config.agents = { [agentId]: pluginBinding() };
+  config.baseUrl = `http://127.0.0.1:${server.port}`;
+  config.websocketUrl = `ws://127.0.0.1:${server.port}/ws`;
+  config.mediaUploadUrl = `http://127.0.0.1:${server.port}/media/upload`;
+  return {
+    config,
+    state,
+    original,
+    rotated,
+    requests,
+    handshakes,
+    persistedBeforeHandshake,
+    errors,
+    mediaAuthorization,
+    upload: async () => await handle?.uploadClientMedia?.(new Blob(["test"]), "note.txt"),
+    disconnect: (code = 1012) => socket?.close(code, "fixture restart"),
+    start: async () => {
+      await handle?.close();
+      const activation = await state.getActivation(agentId);
+      if (!activation) throw new Error("Fixture binding missing");
+      handle = await startBindingRuntime({
+        agentId,
+        activation,
+        deviceId: websocketDevice,
+        config,
+        configPath: join(workspace, "config.json"),
+        stateStore: state,
+        workspaces: new WorkspaceCatalog(state),
+        runtimeAdapters,
+        verifyInstalledSkills: async () => undefined,
+        writeError: (message) => errors.push(message),
+      });
+    },
+    async close() {
+      await handle?.close();
+      server.stop(true);
+      await runtimeAdapters.close();
+      await state.close();
+      await rm(workspace, { recursive: true, force: true });
+    },
+  };
+}
