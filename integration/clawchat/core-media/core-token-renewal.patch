+test("a cold start refreshes expired credentials, persists on the original binding and uses the pair after restart", async () => {
+  const now = Math.floor(Date.now() / 1000);
+  const f = await fixture({ iat: now - validFor, exp: now - 1 });
+  try {
+    await f.start();
+    expect(f.requests).toEqual([
+      { device: pairedDevice, authorization: null, body: { refresh_token: f.original.refreshToken } },
+    ]);
+    expect(f.handshakes).toEqual([f.rotated.accessToken]);
+    expect(f.persistedBeforeHandshake).toEqual([true]);
+    expect(await f.state.getActivation(agentId)).toEqual(f.rotated);
+    await f.start();
+    expect(f.requests).toHaveLength(1);
+    expect(f.handshakes).toEqual([f.rotated.accessToken, f.rotated.accessToken]);
+    expect(f.persistedBeforeHandshake).toEqual([true, true]);
+  } finally {
+    await f.close();
+  }
+});
+
+test("a running binding refreshes before expiry and its next ordinary reconnect uses the persisted credential", async () => {
+  const random = spyOn(Math, "random").mockReturnValue(0.5);
+  const now = Math.floor(Date.now() / 1000);
+  const f = await fixture({ iat: now - 30, exp: now + 1802 });
+  try {
+    await f.start();
+    expect(f.handshakes).toEqual([f.original.accessToken]);
+    await waitUntil(async () => (await f.state.getActivation(agentId))?.accessToken === f.rotated.accessToken);
+    expect(f.requests).toHaveLength(1);
+    expect(f.handshakes).toEqual([f.original.accessToken]);
+    expect(await f.upload()).toMatchObject({ name: "note.txt" });
+    expect(f.mediaAuthorization).toEqual([`Bearer ${f.rotated.accessToken}`]);
+    f.disconnect();
+    await waitUntil(() => f.persistedBeforeHandshake.length === 2);
+    expect(f.handshakes.at(-1)).toBe(f.rotated.accessToken);
+    expect(f.persistedBeforeHandshake).toEqual([true, true]);
+    expect(f.requests).toHaveLength(1);
+  } finally {
+    await f.close();
+    random.mockRestore();
+  }
+});
+
+async function waitUntil(predicate: () => boolean | Promise<boolean>) {
+  const deadline = Date.now() + 4000;
+  while (!(await predicate())) {
+    if (Date.now() > deadline) throw new Error("Connector did not reach expected state");
+    await Bun.sleep(10);
+  }
+}
