+          chatType: "direct",
+          filePath: fixture(name),
+          caption: "M2 fixed fixture",
+          replyToMessageId: "msg_source",
+          ...(kind === "audio" ? { duration: 600 } : {}),
+          ...(kind === "video" ? { duration: 1000, width: 160, height: 96 } : {}),
+        },
+        options({ uploadMedia, sendMessageEnvelope }),
+      );
+      expect(result).toMatchObject({ sent: true, messageId: `msg_ack_${kind}`, kind, name, mime });
+      expect(uploadMedia).toHaveBeenCalledTimes(1);
+      expect(sendMessageEnvelope).toHaveBeenCalledTimes(1);
+      if (kind === "audio" || kind === "video") {
+        const payload = sendMessageEnvelope.mock.calls[0]?.[2] as MessagePayload;
+        const fragment = payload.message.body.fragments.at(-1) as Record<string, unknown>;
+        expect(fragment.duration).toBe(kind === "audio" ? 600 : 1000);
+        if (kind === "video") expect(fragment).toMatchObject({ width: 160, height: 96 });
+      }
+    });
+  }
+
+  it("does not send a message when upload fails", async () => {
