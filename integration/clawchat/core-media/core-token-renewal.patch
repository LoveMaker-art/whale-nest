+test("an expired binding backs off after a temporary platform error and retries with the original binding", async () => {
+  const actualNow = Date.now();
+  const now = Math.floor(actualNow / 1000);
+  const clock = spyOn(Date, "now").mockReturnValue(actualNow);
+  let attempts = 0;
+  const f = await fixture(
+    { iat: now - validFor, exp: now - 1 },
+    {
+      refresh: async () => {
+        attempts++;
+        if (attempts === 1) return Response.json({ code: 500, msg: "fixture unavailable" }, { status: 503 });
+        return Response.json({
+          code: 0,
+          data: { access_token: f.rotated.accessToken, refresh_token: f.rotated.refreshToken },
+        });
+      },
+    },
+  );
+  const renew = new ClawChatTokenRenewal(f.original, {
+    baseUrl: f.config.baseUrl,
+    deviceId: websocketDevice,
+    state: f.state,
+    onError: () => undefined,
+    onBlocked: () => undefined,
+  });
+  try {
+    expect(await renew.beforeConnect()).toBe(false);
+    expect(await renew.beforeConnect()).toBe(false);
+    expect(attempts).toBe(1);
+    clock.mockReturnValue(actualNow + 31_000);
+    expect(await renew.beforeConnect()).toBe(true);
+    expect(attempts).toBe(2);
+    expect(await f.state.getActivation(agentId)).toEqual(f.rotated);
+  } finally {
+    await renew.stop();
+    await f.close();
+    clock.mockRestore();
+  }
+});
