+
+/** Recheck the activation of an already loaded Plugin before accepting work. */
+export async function isPluginActivationCurrent(
+  configPath: string,
+  pluginId: string,
+  activationGeneration: number,
+): Promise<boolean> {
+  const id = requireIdentity(pluginId, "Plugin ID");
+  const lockfile = await readPluginLockfile(pluginInstallationPaths(configPath).lockfile);
+  if (!Object.hasOwn(lockfile.plugins, id)) return false;
+  const entry = lockfile.plugins[id];
+  return isRecord(entry) && entry.pluginId === id && entry.status === "active"
+    && entry.activationGeneration === activationGeneration;
 }
 
