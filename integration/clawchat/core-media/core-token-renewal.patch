+test("10003 adopts a newer persisted pair after a race and rejects terminal expiry without re-pairing otherwise", async () => {
+  const now = Math.floor(Date.now() / 1000);
+  for (const race of [false, true]) {
+    const f = await fixture(
+      { iat: now - validFor, exp: now - 1 },
+      {
+        refresh: async () => {
+          if (race) await f.state.upsertActivation(f.rotated);
+          return Response.json({ code: 10003, msg: "fixture response" });
+        },
+      },
+    );
+    try {
+      if (race) {
+        await f.start();
+        expect(f.handshakes).toEqual([f.rotated.accessToken]);
+      } else {
+        await expect(f.start()).rejects.toThrow("renewal credential was rejected");
+        expect(f.handshakes).toEqual([]);
+        expect(await f.state.getActivation(agentId)).toEqual(f.original);
+      }
+      expect(f.requests).toHaveLength(1);
+    } finally {
+      await f.close();
+    }
+  }
+});
