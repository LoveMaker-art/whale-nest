+++ b/tests/media-send-tool.test.ts
@@ -0,0 +1,262 @@
+import { afterEach, describe, expect, it, mock } from "bun:test";
+import { mkdtemp, realpath, rm, symlink, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { getConnectTool, recordToolInput, validateToolInput } from "../src/agent/tool-catalog";
+import { executeConnectTool, isIndeterminateToolError } from "../src/agent/tool-executor";
+import { type MessagePayload, MessageSendError, StateError } from "../src/clawchat/protocol";
+import type { ConnectWsClient } from "../src/clawchat/ws-client";
+import type { ActivationCredentials } from "../src/types";
+
+const activation: ActivationCredentials = {
+  localAgentId: "dsh",
+  accessToken: "test-only",
+  refreshToken: null,
+  serverAgentId: "agent-test",
+  userId: "user-test",
+  ownerUserId: "owner-test",
+  conversationId: "cnv_owner",
+};
+const temporary: string[] = [];
+afterEach(async () => {
+  for (const dir of temporary.splice(0)) await rm(dir, { recursive: true, force: true });
+});
+const fixture = (name: string) => join(import.meta.dir, "fixtures/media-send", name);
+const options = (wsClient: unknown) => ({
+  baseUrl: "https://unused.test",
+  deviceId: "device-test",
+  activation,
+  wsClient: wsClient as ConnectWsClient,
+});
+
+describe("generic media delivery through the existing Core connection", () => {
+  for (const [name, kind, mime] of [
+    ["image.png", "image", "image/png"],
+    ["audio.wav", "audio", "audio/wav"],
+    ["document.txt", "file", "text/plain"],
+    ["video.mp4", "video", "video/mp4"],
+  ] as const) {
+    it(`uploads and sends ${kind} through the supplied connection and returns its real ack`, async () => {
+      const uploadMedia = mock(async (file: Blob, args: { filename: string }) => {
+        expect(file.type.split(";")[0]).toBe(mime);
+        expect(args.filename).toBe(name);
+        return { kind, url: `https://media.test/${name}`, name, mime, size: file.size };
+      });
+      const sendMessageEnvelope = mock(async (...args: unknown[]) => {
+        expect(args[0]).toBe("message.reply");
+        expect(args[1]).toBe("cnv_owner");
+        const payload = args[2] as MessagePayload;
+        expect(payload.message.body.fragments).toContainEqual(expect.objectContaining({ kind, name, mime }));
+        expect(payload.message.context.reply?.reply_to_msg_id).toBe("msg_source");
+        expect(args[3]).toEqual({ toType: "direct" });
+        return { payload: { message_id: `msg_ack_${kind}` } };
+      });
+      const result = await executeConnectTool(
+        "clawchat_send_media",
+        {
+          chatId: "cnv_owner",
+          chatType: "direct",
+          filePath: fixture(name),
+          caption: "M2 fixed fixture",
+          replyToMessageId: "msg_source",
+          ...(kind === "audio" ? { duration: 600 } : {}),
+          ...(kind === "video" ? { duration: 1000, width: 160, height: 96 } : {}),
+        },
+        options({ uploadMedia, sendMessageEnvelope }),
+      );
+      expect(result).toMatchObject({ sent: true, messageId: `msg_ack_${kind}`, kind, name, mime });
+      expect(uploadMedia).toHaveBeenCalledTimes(1);
+      expect(sendMessageEnvelope).toHaveBeenCalledTimes(1);
+      if (kind === "audio" || kind === "video") {
+        const payload = sendMessageEnvelope.mock.calls[0]?.[2] as MessagePayload;
+        const fragment = payload.message.body.fragments.at(-1) as Record<string, unknown>;
+        expect(fragment.duration).toBe(kind === "audio" ? 600 : 1000);
+        if (kind === "video") expect(fragment).toMatchObject({ width: 160, height: 96 });
+      }
+    });
+  }
+
+  it("does not send a message when upload fails", async () => {
+    const sendMessageEnvelope = mock(async () => {
+      throw Error("must not run");
+    });
+    await expect(
+      executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav") },
+        options({
+          uploadMedia: async () => {
+            throw Error("upload rejected");
+          },
+          sendMessageEnvelope,
+        }),
+      ),
+    ).rejects.toThrow("upload rejected");
+    expect(sendMessageEnvelope).not.toHaveBeenCalled();
+  });
+
+  it("keeps a post-submission connection error indeterminate without retrying", async () => {
+    const sendMessageEnvelope = mock(async () => {
+      throw Error("connection dropped after submission");
+    });
+    let caught: unknown;
+    try {
+      await executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav") },
+        options({
+          uploadMedia: async () => ({
+            kind: "audio",
+            url: "https://media.test/audio.wav",
+            name: "audio.wav",
+            mime: "audio/wav",
+            size: 19244,
+          }),
+          sendMessageEnvelope,
+        }),
+      );
+    } catch (error) {
+      caught = error;
+    }
+    expect(isIndeterminateToolError(caught)).toBe(true);
+    expect(sendMessageEnvelope).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps Core shutdown during a submitted send indeterminate", async () => {
+    let caught: unknown;
+    try {
+      await executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav") },
+        options({
+          uploadMedia: async () => ({
+            kind: "audio",
+            url: "https://media.test/audio.wav",
+            name: "audio.wav",
+            mime: "audio/wav",
+            size: 19244,
+          }),
+          sendMessageEnvelope: async () => {
+            throw new StateError("client closed");
+          },
+        }),
+      );
+    } catch (error) {
+      caught = error;
+    }
+    expect(isIndeterminateToolError(caught)).toBe(true);
+  });
+
+  it("refuses relative paths, directories, symlinks and empty files before upload", async () => {
+    const root = await mkdtemp(join(await realpath(tmpdir()), "media-send-"));
+    temporary.push(root);
+    await writeFile(join(root, "empty.wav"), "");
+    await symlink(fixture("audio.wav"), join(root, "link.wav"));
+    const uploadMedia = mock(async () => {
+      throw Error("must not upload");
+    });
+    for (const filePath of ["relative.wav", root, join(root, "link.wav"), join(root, "empty.wav")]) {
+      await expect(
+        executeConnectTool(
+          "clawchat_send_media",
+          { chatId: "cnv_owner", chatType: "direct", filePath },
+          options({ uploadMedia }),
+        ),
+      ).rejects.toThrow();
+    }
+    expect(uploadMedia).not.toHaveBeenCalled();
+  });
+
+  it("preserves a definite platform rejection as failed", async () => {
+    const rejection = new MessageSendError("not_member");
+    let caught: unknown;
+    try {
+      await executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav") },
+        options({
+          uploadMedia: async () => ({
+            kind: "audio",
+            url: "https://media.test/audio.wav",
+            name: "audio.wav",
+            mime: "audio/wav",
+            size: 19244,
+          }),
+          sendMessageEnvelope: async () => {
+            throw rejection;
+          },
+        }),
+      );
+    } catch (error) {
+      caught = error;
+    }
+    expect(caught).toBe(rejection);
+    expect(isIndeterminateToolError(caught)).toBe(false);
+  });
+
+  it("refuses to report sent without a message ID in the acknowledgement", async () => {
+    let caught: unknown;
+    try {
+      await executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav") },
+        options({
+          uploadMedia: async () => ({
+            kind: "audio",
+            url: "https://media.test/audio.wav",
+            name: "audio.wav",
+            mime: "audio/wav",
+            size: 19244,
+          }),
+          sendMessageEnvelope: async () => ({ payload: {} }),
+        }),
+      );
+    } catch (error) {
+      caught = error;
+    }
+    expect(isIndeterminateToolError(caught)).toBe(true);
+  });
+
+  it("refuses changed file bytes before upload and a kind mismatch before sending", async () => {
+    const uploadMedia = mock(async () => ({
+      kind: "file",
+      url: "https://media.test/file",
+      name: "audio.wav",
+      mime: "application/octet-stream",
+      size: 19244,
+    }));
+    const sendMessageEnvelope = mock(async () => ({ payload: { message_id: "must-not-send" } }));
+    await expect(
+      executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav"), sha256: "0".repeat(64) },
+        options({ uploadMedia, sendMessageEnvelope }),
+      ),
+    ).rejects.toThrow("SHA-256 mismatch");
+    expect(uploadMedia).not.toHaveBeenCalled();
+    await expect(
+      executeConnectTool(
+        "clawchat_send_media",
+        { chatId: "cnv_owner", chatType: "direct", filePath: fixture("audio.wav"), expectedKind: "audio" },
+        options({ uploadMedia, sendMessageEnvelope }),
+      ),
+    ).rejects.toThrow("kind mismatch");
+    expect(sendMessageEnvelope).not.toHaveBeenCalled();
+  });
+
+  it("requires exact chat type, validates metadata, and redacts recorded file paths", () => {
+    const tool = getConnectTool("clawchat_send_media");
+    expect(tool).not.toBeNull();
+    if (!tool) throw Error("media tool not registered");
+    expect(() => validateToolInput(tool, { chatId: "cnv_owner", filePath: fixture("audio.wav") })).toThrow("chatType");
+    expect(() =>
+      validateToolInput(tool, {
+        chatId: "cnv_owner",
+        chatType: "direct",
+        filePath: fixture("audio.wav"),
+        duration: -1,
+      }),
+    ).toThrow("duration");
+    expect(recordToolInput(tool, { filePath: fixture("audio.wav") })).toEqual({ filePath: "audio.wav" });
+  });
+});
