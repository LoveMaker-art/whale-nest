+        expect(payload.message.body.fragments).toContainEqual(expect.objectContaining({ kind, name, mime }));
+        expect(payload.message.context.reply?.reply_to_msg_id).toBe("msg_source");
+        expect(args[3]).toEqual({ toType: "direct" });
+        return { payload: { message_id: `msg_ack_${kind}` } };
