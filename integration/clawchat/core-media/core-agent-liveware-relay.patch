@@ -0,0 +1,45 @@
+import { expect, test } from "bun:test";
+import { createAgentLivewareRelay } from "../src/service/agent-liveware-relay";
+
+test("one relay per binding, resumes after exit and closes on shutdown", async () => {
+  let opens = 0;
+  let stops = 0;
+  let exited = Promise.withResolvers<number>();
+  const relay = createAgentLivewareRelay({
+    async open() {
+      opens++;
+      const process = exited;
+      return {
+        exited: process.promise,
+        ready: Promise.resolve(),
+        async stop() { stops++; process.resolve(0); },
+      };
+    },
+    onError() { throw new Error("unexpected relay error"); },
+  });
+  await Promise.all([relay.start(), relay.start()]);
+  expect(opens).toBe(1);
+  exited.resolve(1);
+  exited = Promise.withResolvers<number>();
+  await Promise.resolve();
+  await relay.start();
+  expect(opens).toBe(2);
+  await Promise.all([relay.close(), relay.close()]);
+  expect(stops).toBe(1);
+  await relay.start();
+  expect(opens).toBe(2);
+});
+
+test("a failed startup does not prevent another attempt", async () => {
+  let opens = 0;
+  let errors = 0;
+  const relay = createAgentLivewareRelay({
+    async open() { opens++; throw new Error("unavailable"); },
+    onError() { errors++; },
+  });
+  await relay.start();
+  await relay.start();
+  await relay.close();
+  expect(opens).toBe(2);
+  expect(errors).toBe(2);
+});
